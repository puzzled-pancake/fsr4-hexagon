#version 310 es
// RCAS port — FidelityFX SDK rcas.hlsl + FSR1 FsrRcasF (ffx_fsr1.h
//:684-773), exact math: luma x2 = B*0.5 + (R*0.5 + G); denoise nz term;
// ring min/max + lowerLimiterMultiplier; hitMin/hitMax lobes; FSR_RCAS_LIMIT
// 0.1875 clamp; con.x = exp2(-sharpness_stops) with stops = -2*s+2 (provider
//:1948); resolve with the MEDIUM-PRECISION reciprocal (intBitsToFloat
// 0x7EF127EA trick — intentional, avoids tonality shifts). Operates in
// MU-LAW domain (post hands it model_color unconverted), converts and
// divides exposure at the end (rcas.hlsl:49).
precision highp float;
precision highp int;
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 10) readonly buffer InC { uint inc[]; }; // SSBO10 (mu-law model color
 // = postA's history write; clamp >=0 on load
 // makes it identical to the old SSBO7 path)
layout(std430, binding = 11) writeonly buffer Out8 { uint out8w[]; }; // RGBA8 final
layout(std430, binding = 14) writeonly buffer OutC2 { uint outf[]; }; // fp16 converted (out16 path)

uniform float u_expo; // exposure for the final division
uniform float u_sharp; // game sharpness [0,1]
uniform float u_out16; // F1: >0.5 = also write the fp16 frame (u8out=0 path);
 // production (u8 readback) skips the 16.6MB dead write

const float FSR_RCAS_LIMIT = 0.25 - 1.0 / 16.0;

vec3 removeMuLaw(vec3 rgb) {
 return max((exp(8.51788 * rgb) - 1.0) / 150.0, vec3(0.0));
}
vec3 load3(ivec2 p) {
 p = clamp(p, ivec2(0), ivec2(1919, 1079));
 uint base = (uint(p.y) * 1920u + uint(p.x)) * 2u;
 return max(vec3(unpackHalf2x16(inc[base]), unpackHalf2x16(inc[base + 1u]).x), vec3(0.0)); // hist is unclamped
}
/* shared 10x10-word-pair tile covering this group's 8x8 + halo.
 * Tile position (c,r) holds the word from clamp(base+(c,r)) — so for ANY
 * tap, tile[clamp(tap) - base] reproduces load3's clamped fetch bit-for-
 * bit (clamp(base + (clampedtap-base)) == clampedtap; local index is
 * provably in [0,9] since taps span [gid*8-1, gid*8+8]). */
shared uint s_t[10 * 10 * 2];
vec3 load3T(ivec2 p, ivec2 base) {
 int lx = clamp(clamp(p.x, 0, 1919) - base.x, 0, 9);
 int ly = clamp(clamp(p.y, 0, 1079) - base.y, 0, 9);
 uint idx = (uint(ly) * 10u + uint(lx)) * 2u;
 return max(vec3(unpackHalf2x16(s_t[idx]), unpackHalf2x16(s_t[idx + 1u]).x), vec3(0.0));
}
float rcpMed(float x) { /* ffxApproximateReciprocalMedium (ffx_core_gpu_common
:807-811): 0x7ef19fff + one Newton step — parity fix */
 float b = intBitsToFloat(0x7ef19fff - floatBitsToInt(x));
 return b * (-b * x + 2.0);
}

void main() {
 /* cooperative load (100 texels x 2 words = 200 words by 64
 * threads — threads 0-7 carry four words, the rest three) BEFORE any
 * early-out so every thread hits the barrier (dispatch is an exact
 * 240x135 fit anyway) */
 ivec2 base = ivec2(gl_WorkGroupID.xy) * 8 - 1;
 for (uint i = gl_LocalInvocationIndex; i < 200u; i += 64u) {
 uint t = i >> 1; uint w = i & 1u;
 ivec2 p = ivec2(clamp(base.x + int(t % 10u), 0, 1919),
 clamp(base.y + int(t / 10u), 0, 1079));
 s_t[i] = inc[(uint(p.y) * 1920u + uint(p.x)) * 2u + w];
 }
 barrier();

 uvec2 tid = gl_GlobalInvocationID.xy;
 if (tid.x >= 1920u || tid.y >= 1080u) return;
 ivec2 sp = ivec2(tid);

 vec3 b = load3T(sp + ivec2(0, -1), base);
 vec3 d = load3T(sp + ivec2(-1, 0), base);
 vec3 e = load3T(sp, base);
 vec3 f = load3T(sp + ivec2(1, 0), base);
 vec3 h = load3T(sp + ivec2(0, 1), base);

 // luma times 2
 float bL = b.b * 0.5 + (b.r * 0.5 + b.g);
 float dL = d.b * 0.5 + (d.r * 0.5 + d.g);
 float eL = e.b * 0.5 + (e.r * 0.5 + e.g);
 float fL = f.b * 0.5 + (f.r * 0.5 + f.g);
 float hL = h.b * 0.5 + (h.r * 0.5 + h.g);

 // noise detection (FSR_RCAS_DENOISE)
 float nz = 0.25 * bL + 0.25 * dL + 0.25 * fL + 0.25 * hL - eL;
 float lmin = min(min(bL, min(dL, eL)), min(fL, hL));
 float lmax = max(max(bL, max(dL, eL)), max(fL, hL));
 nz = clamp(abs(nz) * rcpMed(max(lmax - lmin, 1e-9)), 0.0, 1.0);
 nz = -0.5 * nz + 1.0;

 // ring min/max per channel
 vec3 mn4 = min(min(b, min(d, f)), h);
 vec3 mx4 = max(max(b, max(d, f)), h);

 // limiters (exact rcp)
 float lll = clamp(eL / max(min(min(bL, dL), min(fL, hL)), 1e-9), 0.0, 1.0);
 vec3 hitMin = mn4 / (4.0 * mx4) * lll;
 vec3 hitMax = (1.0 - mx4) / (4.0 * mn4 - 4.0);
 vec3 lobe3 = max(-hitMin, hitMax);
 float lobe = max(-FSR_RCAS_LIMIT, min(max(max(lobe3.r, lobe3.g), lobe3.b), 0.0));
 lobe *= exp2(2.0 * u_sharp - 2.0); // con.x = exp2(-(-2s+2))
 lobe *= nz;

 // resolve with the medium-precision reciprocal
 float rcpL = rcpMed(4.0 * lobe + 1.0);
 vec3 pix = (lobe * (b + d + h + f) + e) * rcpL;

 // convert out of mu-law, divide exposure
 vec3 fc = clamp(removeMuLaw(pix) / u_expo, vec3(0.0), vec3(64000.0));

 if (u_out16 > 0.5) { /* F1: fp16 frame only for the u8out=0 path */
 uint obase = (tid.y * 1920u + tid.x) * 2u;
 outf[obase] = packHalf2x16(vec2(fc.x, fc.y));
 outf[obase + 1u] = packHalf2x16(vec2(fc.z, 1.0));
 }
 vec3 s = fc * 255.0 + vec3(0.5);
 uvec3 q = uvec3(clamp(floor(s), vec3(0.0), vec3(255.0)));
 out8w[tid.y * 1920u + tid.x] =
 (q.r & 0xffu) | ((q.g & 0xffu) << 8u) | ((q.b & 0xffu) << 16u) | 0xff000000u;
}
