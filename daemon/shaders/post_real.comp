#version 310 es
// FSR4 post — REAL semantics port of AMD post_common.hlsli:
// MULAW ON (the model operates in mu-law color space)
// blend source = SSBO 9 (the pre-pass RECTIFIED history, mu-law domain)
// SSBO 10 out = model color in MU-LAW domain -> service uploads to hist_tex
// final = RemoveMuLaw(model_color) / exposure, clamp 64000
// Recurrent: sigmoid(ch4..7) -> rec texture (imageStore, BF3 pattern).
precision highp float;
precision highp int;
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 4) readonly buffer Npu { uint npu[]; }; // 2 words/texel
layout(std430, binding = 0) readonly buffer Feats { uint feats[]; }; // dist (ch2) for floor decay
layout(std430, binding = 9) readonly buffer Repj { uint rpj[]; }; // fp16 RGBA rectified hist (MU-LAW)
layout(std430, binding = 7) writeonly buffer OutC { uint outf[]; }; // fp16 RGBA final
layout(std430, binding = 10) writeonly buffer Hist { uint hist[]; };// fp16 RGBA mu-law history
layout(std430, binding = 11) writeonly buffer Out8 { uint out8w[]; };// RGBA8 out (halved readback)
layout(std430, binding = 13) readonly buffer Mulr { uint mlr[]; }; // mu-law'd LR (mulr.comp)
layout(rgba16f, binding = 1) writeonly uniform highp image2D u_recimg;

uniform vec4 u_params; // x=exposure, y=jitter.x, z=jitter.y, w=blend floor
uniform vec4 u_dims; // x=OS_W, y=OS_H, z=LR_W, w=LR_H
uniform float u_rcas; // >0.5 = RCAS follows (write mu-law, skip convert)
uniform float u_bftau; // chroma-dist scale for floor decay (0 = flat floor)

const float S_OUT = 0.303211569786;

vec3 removeMuLaw(vec3 rgb) {
 return max((exp(8.51788 * rgb) - 1.0) / 150.0, vec3(0.0));
}

int s8ch(uvec2 tid, uint ch) {
 uint word = npu[(tid.y * uint(u_dims.x) + tid.x) * 2u + (ch >> 2u)];
 uint b = (word >> ((ch & 3u) * 8u)) & 0xffu;
 return (b & 0x80u) != 0u ? int(b) - 256: int(b);
}
vec3 loadRGB(uint w0, uint w1) {
 return vec3(unpackHalf2x16(w0), unpackHalf2x16(w1).x);
}
vec3 loadRepj(uvec2 p) {
 uint base = (p.y * uint(u_dims.x) + p.x) * 2u;
 return loadRGB(rpj[base], rpj[base + 1u]);
}
/* mu-law'd LR baked by mulr.comp (exposure 1 baked in) */
vec3 loadMulr(ivec2 p) {
 p = clamp(p, ivec2(0), ivec2(int(u_dims.z) - 1, int(u_dims.w) - 1));
 uint base = (uint(p.y) * uint(u_dims.z) + uint(p.x)) * 2u;
 return vec3(unpackHalf2x16(mlr[base]), unpackHalf2x16(mlr[base + 1u]).x);
}

void main() {
 uvec2 tid = gl_GlobalInvocationID.xy;
 if (tid.x >= uint(u_dims.x) || tid.y >= uint(u_dims.y)) return;

 float exposure = u_params.x;
 vec2 jitter = u_params.yz;

 float p0 = float(s8ch(tid, 0u)) * S_OUT;
 float p1 = float(s8ch(tid, 1u)) * S_OUT;
 float p2 = float(s8ch(tid, 2u)) * S_OUT;
 float p3 = float(s8ch(tid, 3u)) * S_OUT;
 vec4 rv = vec4(float(s8ch(tid, 4u)), float(s8ch(tid, 5u)),
 float(s8ch(tid, 6u)), float(s8ch(tid, 7u))) * S_OUT;

 vec4 rec = vec4(1.0) / (vec4(1.0) + exp2(-rv * 1.4426950409));
 /* the SDK's recurrent resource is R8G8B8A8_UNORM —
 * quantize the sigmoid to 8-bit steps before storing so the model's
 * recurrent feedback matches its training distribution */
 rec = floor(rec * 255.0 + 0.5) / 255.0;
 imageStore(u_recimg, ivec2(tid), rec);

 float correlation = (exp2(p0 * 1.4426950409) - exp2(-p0 * 1.4426950409)) / (exp2(p0 * 1.4426950409) + exp2(-p0 * 1.4426950409));
 float sfx = 2.0 / (1.0 + exp2(-p1 * 1.4426950409));
 float sfy = 2.0 / (1.0 + exp2(-p2 * 1.4426950409));

 vec2 lr_f = vec2(-0.25) + vec2(tid) * 0.5 + jitter; // -0.5 + inv_scale/2 + tid*inv_scale
 ivec2 lr_i = ivec2(roundEven(lr_f));

 vec3 up = vec3(0.0);
 float tw = 0.0;
 for (int dy = 0; dy < 3; ++dy) {
 mediump float yd = (float(lr_i.y + dy - 1) - lr_f.y) * 2.0; // fp16 math on Adreno
 for (int dx = 0; dx < 3; ++dx) {
 mediump float xd = (float(lr_i.x + dx - 1) - lr_f.x) * 2.0;
 mediump float gw = exp2((-0.5 / (0.47 * 0.47)) * 1.4426950409 *
 (xd * xd * sfx * sfx + 2.0 * correlation * (xd * yd) * sfx * sfy +
 yd * yd * sfy * sfy));
 tw += gw;
 up += loadMulr(lr_i + ivec2(dx - 1, dy - 1)) * gw; // baked mu-law
 }
 }
 up /= tw;

 float blend = 1.0 / (1.0 + exp2(-p3 * 1.4426950409));
 /* blend floor, desktop-divergence-aware:
 * (a) BLACK-GUARD — on invalid-MV disocclusion the reproj is true black;
 * flooring there creates 75%-black ghosts; let the model's own low
 * blend through instead.
 * (b) DIST DECAY (FSR4_BFTAU > 0) — the chroma-dist the net itself uses
 * as its disocclusion cue (feature ch2) decays the floor where the
 * rectified history mismatches; static detail keeps the full floor
 * (the carpet-buzz fix), moving/mismatched regions stop trailing.
 * F4: rp loaded ONCE (was fetched again for the blend below —
 * 16.6MB of SSBO reads if the driver didn't CSE). */
 vec3 rp = loadRepj(tid);
 float bfloor = u_params.w;
 if (max(max(rp.r, rp.g), rp.b) <= 0.0) {
 bfloor = 0.0;
 } else if (u_bftau > 0.0) {
 float dist = unpackHalf2x16(feats[(tid.y * uint(u_dims.x) + tid.x) * 4u + 1u]).x;
 bfloor *= clamp(1.0 - dist / u_bftau, 0.0, 1.0);
 }
 blend = max(blend, bfloor); // floor: 0 = AMD reference
 vec3 model_color = up * (1.0 - blend) + rp * blend;

 uint obase = (tid.y * uint(u_dims.x) + tid.x) * 2u;
 hist[obase] = packHalf2x16(model_color.xy);
 hist[obase + 1u] = packHalf2x16(vec2(model_color.z, 1.0));

 if (u_rcas > 0.5) {
 /* rcas reads SSBO 10 (the history write) directly — the old
 * mu-law SSBO7 mirror here is dead; postA is the split-mode variant
 * of everything above. Nothing left to write in RCAS mode. */
 return;
 }

 vec3 fc = clamp(removeMuLaw(model_color) / exposure, vec3(0.0), vec3(64000.0));
 outf[obase] = packHalf2x16(vec2(fc.x, fc.y));
 outf[obase + 1u] = packHalf2x16(vec2(fc.z, 1.0));

 /* RGBA8 mirror of the final color — same encoding as the daemon's
 * out16_to_u8 (v<=0 -> 0; v>=1 -> 255; else trunc(v*255+0.5)); the
 * service reads THIS back (8.3MB instead of 16.6MB) and the daemon sends
 * it directly. */
 vec3 s = fc * 255.0 + vec3(0.5);
 uvec3 q = uvec3(clamp(floor(s), vec3(0.0), vec3(255.0)));
 out8w[tid.y * uint(u_dims.x) + tid.x] =
 (q.r & 0xffu) | ((q.g & 0xffu) << 8u) | ((q.b & 0xffu) << 16u) | 0xff000000u;
}
