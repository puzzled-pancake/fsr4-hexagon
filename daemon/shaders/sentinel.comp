#version 310 es
// sentinel: md5 parity cannot detect a COHERENT
// STALE FRAME — a valid previous frame is self-consistent. This probe reads
// 64 deterministic pseudo-random texels of the AHB the GPU path just
// consumed (image unit 4, still bound from postA's tail slot) and packs the
// raw bytes for CPU comparison against the mmap'd dma-buf view. Any
// mismatch = the GL view saw something other than what the DSP wrote.
// Byte recovery is the device-proven UNORM round-trip (k/255 fetch -> exact k).
precision highp float;
precision highp int;
layout(local_size_x = 64) in;
layout(rgba8, binding = 4) readonly uniform highp image2D NpuImg;
layout(std430, binding = 16) writeonly buffer Sent { uint sent[]; };
void main() {
 uint i = gl_GlobalInvocationID.x; // 0..63
 uint idx = (i * 2654435761u + 12345u) % (3840u * 1080u);
 vec4 t = imageLoad(NpuImg, ivec2(int(idx % 3840u), int(idx / 3840u)));
 uvec4 b = uvec4(clamp(roundEven(t * 255.0), vec4(0.0), vec4(255.0)));
 sent[i] = b.x | (b.y << 8) | (b.z << 16) | (b.w << 24);
}
